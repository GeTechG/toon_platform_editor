{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:toon-platform:format:toon-v2",
  "title": "Toon animation document, schema version 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "width", "height", "frame_rate", "tools", "frames"],
  "properties": {
    "schema_version": { "const": 2 },
    "width": { "type": "integer", "minimum": 1, "maximum": 32767 },
    "height": { "type": "integer", "minimum": 1, "maximum": 32767 },
    "frame_rate": { "type": "integer", "minimum": 1, "maximum": 60 },
    "tools": {
      "type": "array",
      "maxItems": 65536,
      "items": { "$ref": "#/$defs/tool" }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/frame" }
    }
  },
  "$defs": {
    "tool": {
      "oneOf": [
        { "$ref": "#/$defs/pencil" },
        { "$ref": "#/$defs/eraser" }
      ]
    },
    "pencil": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "dialect", "width", "color"],
      "properties": {
        "kind": { "const": "pencil" },
        "dialect": { "enum": ["multator", "toonio"] },
        "width": { "type": "integer", "minimum": 1, "maximum": 4800 },
        "color": { "type": "string", "pattern": "^#[0-9a-f]{6}$" }
      }
    },
    "eraser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "dialect", "width"],
      "properties": {
        "kind": { "const": "eraser" },
        "dialect": { "enum": ["multator", "toonio"] },
        "width": { "type": "integer", "minimum": 1, "maximum": 4800 }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strokes"],
      "properties": {
        "strokes": {
          "type": "array",
          "maxItems": 16384,
          "items": { "$ref": "#/$defs/stroke" }
        }
      }
    },
    "stroke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points", "tool_id"],
      "properties": {
        "points": {
          "type": "array",
          "minItems": 2,
          "maxItems": 65536,
          "items": { "type": "integer", "minimum": -32768, "maximum": 32767 }
        },
        "tool_id": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    }
  }
}
