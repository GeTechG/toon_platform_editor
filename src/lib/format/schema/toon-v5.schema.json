{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:toon-platform:format:toon-v5",
  "title": "Toon animation document, schema version 5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "width",
    "height",
    "frame_rate",
    "tools",
    "layers"
  ],
  "properties": {
    "schema_version": {
      "const": 5
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32767
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32767
    },
    "frame_rate": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "tools": {
      "type": "array",
      "maxItems": 65536,
      "items": {
        "$ref": "#/$defs/tool"
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/layer"
      }
    }
  },
  "$defs": {
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hidden",
        "frames"
      ],
      "properties": {
        "hidden": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12
        },
        "frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/frame"
          }
        }
      }
    },
    "tool": {
      "oneOf": [
        {
          "$ref": "#/$defs/pencil"
        },
        {
          "$ref": "#/$defs/eraser"
        },
        {
          "$ref": "#/$defs/contour"
        },
        {
          "$ref": "#/$defs/contour-eraser"
        },
        {
          "$ref": "#/$defs/feather"
        },
        {
          "$ref": "#/$defs/pixel"
        }
      ]
    },
    "pencil": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "dialect",
        "width",
        "color"
      ],
      "properties": {
        "kind": {
          "const": "pencil"
        },
        "dialect": {
          "enum": [
            "multator",
            "toonio"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4800
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        }
      }
    },
    "eraser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "dialect",
        "width"
      ],
      "properties": {
        "kind": {
          "const": "eraser"
        },
        "dialect": {
          "enum": [
            "multator",
            "toonio"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4800
        }
      }
    },
    "contour": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "dialect",
        "color"
      ],
      "properties": {
        "kind": {
          "const": "contour"
        },
        "dialect": {
          "enum": [
            "multator"
          ]
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        }
      }
    },
    "contour-eraser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "dialect"
      ],
      "properties": {
        "kind": {
          "const": "contour-eraser"
        },
        "dialect": {
          "enum": [
            "multator"
          ]
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strokes"
      ],
      "properties": {
        "strokes": {
          "type": "array",
          "maxItems": 16384,
          "items": {
            "$ref": "#/$defs/stroke"
          }
        }
      }
    },
    "stroke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "points",
        "tool_id"
      ],
      "properties": {
        "points": {
          "type": "array",
          "minItems": 2,
          "maxItems": 65536,
          "items": {
            "type": "integer",
            "minimum": -32768,
            "maximum": 32767
          }
        },
        "tool_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "feather": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "dialect",
        "width",
        "color",
        "fill"
      ],
      "properties": {
        "kind": {
          "const": "feather"
        },
        "dialect": {
          "enum": [
            "multator",
            "toonio"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4800
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "fill": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        }
      }
    },
    "pixel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "dialect",
        "width",
        "color"
      ],
      "properties": {
        "kind": {
          "const": "pixel"
        },
        "dialect": {
          "enum": [
            "toonio"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4800
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        }
      }
    }
  }
}
