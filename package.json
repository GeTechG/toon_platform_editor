{
  "name": "toon-editor",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./icon": {
      "types": "./src/lib/ui/Icon.svelte",
      "svelte": "./src/lib/ui/Icon.svelte",
      "default": "./src/lib/ui/Icon.svelte"
    },
    "./player": {
      "types": "./src/player.ts",
      "svelte": "./src/player.ts",
      "default": "./src/player.ts"
    },
    "./i18n": {
      "types": "./src/lib/i18n.ts",
      "svelte": "./src/lib/i18n.ts",
      "default": "./src/lib/i18n.ts"
    }
  },
  "scripts": {
    "dev": "bunx --bun vite",
    "bench": "bunx --bun vite --open /bench.html",
    "build": "bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "test": "bun test src examples",
    "test:watch": "bun test --watch src",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/bun": "^1.3.0",
    "svelte": "^5.56.5",
    "svelte-check": "^4.7.2",
    "typescript": "^5.9.3",
    "vite": "^8.1.4"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "gifenc": "^1.0.3",
    "i18next": "^26.4.2",
    "mediabunny": "^1.58.1"
  }
}
